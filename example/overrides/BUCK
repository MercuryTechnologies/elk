load("@elk//:elk.bzl", "elk_packages", "uv_packages")
load("//example/uv:uv.lock.toml", lock = "value")

# The uv example's lock, with two of its packages replaced. Pure-Python tags
# only, so the native wheels in that lock are left out.
elk_packages(
    packages = uv_packages(lock),
    platform_tags = {
        "linux-x86_64": ["py3-none-any"],
    },
    overrides = {
        # Built on elk's own download of the pinned wheel, the way a fixup
        # (patchelf, or dropping a bundled binary) would be.
        "colorama": ":colorama-fixed",
        # Written from source instead of the wheel.
        "cowsay": ":cowsay-local",
    },
)

genrule(
    name = "colorama-fixed.whl",
    srcs = [":colorama-0.4.6-py2.py3-none-any.whl"],
    out = "colorama-0.4.6-py2.py3-none-any.whl",
    cmd = "cp $SRCS $OUT",
)

prebuilt_python_library(
    name = "colorama-fixed",
    binary_src = ":colorama-fixed.whl",
)

python_library(
    name = "cowsay-local",
    srcs = ["cowsay/__init__.py"],
    # importable as `cowsay`, not `example.overrides.cowsay`
    base_module = "",
)

python_binary(
    name = "main",
    main = "main.py",
    deps = [
        ":colorama",
        ":cowsay",
    ],
)
